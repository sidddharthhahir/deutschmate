# Copy to .env.local and fill in.
#
# Everything except three things works WITHOUT this key, and each of the three
# fails honestly rather than silently:
#   conversation -> the unit's scripted branching dialogue
#   writing      -> queued locally, corrected whenever a key/network appears
#   "Erklär mir das" -> served from cache if anyone has asked before;
#                       otherwise it says it is unavailable
# Wrong answers are still explained: the rule-based tier needs no key.
# That is by design (spec §17): a session must be finishable offline.
ANTHROPIC_API_KEY=

# Dollars per learner per rolling 30 days. ENFORCED, not just displayed: every
# paid call checks the month's spend first and falls back to the offline path
# once it is gone — the same path a missing key takes, so a session is still
# finishable. Default 5, so two people on one install share $10. Set it to 0 to
# run with no AI spending at all.
DEUTSCHMATE_BUDGET=5

# Lets a request name a learner other than the one in the cookie, via ?user= or
# a "user" field in a POST body. THE TEST SUITE IS THE ONLY THING THAT NEEDS IT:
# six suites drive throwaway learners, and isolation by user id is exactly the
# mechanism they should be exercising.
#
# Without it, both are ignored entirely and every request is whoever the cookie
# says — which is what you want anywhere other people can reach the server.
# `npm run setup` generates one; delete the line to turn impersonation off.
# Fails closed: no variable, no trust. Must be at least 24 characters.
DEUTSCHMATE_TEST_AUTH=

# The admin tools at /admin write to SHARED content — /api/video runs
# `UPDATE unit SET video_id`, which changes the curriculum for every learner.
# Off unless this is exactly "1". A switch, not a password: it stops the
# accidental and the drive-by, and is no defence against someone who can
# already set your environment.
DEUTSCHMATE_ADMIN=

# Wikimedia requires a User-Agent naming your tool AND a contact URL.
# Without one you get 403 "Please honor our robot policy" — an example.com
# email is rejected too. Only needed when running `npm run audio`.
WIKIMEDIA_CONTACT=https://github.com/yourname/deutschmate; your@email.com
