{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,not-found,error,global-error,template,loading}.{ts,tsx}",
    "scripts/*.mts",
    "tests/*.mts",
    "public/sw.js"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/*.mts", "tests/*.mts"],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreExportsUsedInFile": true
}
