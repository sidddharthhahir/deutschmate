{
  "name": "deutschmate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mts",
    "dev": "next dev",
    "// dev:lan": "Same server, reachable from your phone over the tailnet or LAN.",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mts",
    "seed": "node scripts/seed.mts",
    "audio": "node scripts/fetch-audio.mts",
    "import-words": "node scripts/import-words.mts",
    "import-vocab": "node scripts/import-vocab.mts",
    "import-sentences": "node scripts/import-sentences.mts",
    "attach-examples": "node scripts/attach-examples.mts",
    "backup": "node scripts/backup.mts",
    "restore": "node scripts/restore.mts",
    "export-deck": "node scripts/export-deck.mts",
    "export-design": "node scripts/export-for-design.mts",
    "config": "node scripts/config.mts",
    "videos": "node scripts/videos.mts",
    "export-content": "node scripts/export-content.mts",
    "passwd": "node scripts/passwd.mts",
    "build-a1": "node scripts/build-a1.mts",
    "build-a2": "node scripts/build-a2.mts",
    "// build-units": "Generates all six levels. build-a1/build-a2 only emit the levels that are hand-written, so this is still the only source of A2.2 upward.",
    "build-units": "node scripts/build-units.mts",
    "// dev tools": "Present on disk and listed nowhere, so nobody found them.",
    "orphans": "node scripts/orphans.mts",
    "tidy-content": "node scripts/tidy-content.mts",
    "walk": "node scripts/walk.mts",
    "check-scenes": "node scripts/check-scenes.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
