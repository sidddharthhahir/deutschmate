# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets stay local, but the template must ship or a fresh clone
# has nothing to copy and no way to know what keys exist.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The database and its backups hold the PROGRESS half — per user, never shared,
# never committed (spec §10). Content is regenerated from data/ by `npm run seed`.
/deutschmate.db
/deutschmate.db-shm
/deutschmate.db-wal
/backups/

# Tatoeba download cache — large, and re-fetchable. The CHOSEN sentences live
# in data/sentences.json and are committed, so setup needs no download.
/data/tatoeba/

# Wiktionary extract (~1 GB) and the frequency list, both re-fetchable by
# `npm run import-vocab`. The words it CHOSE live in data/words-extra.json and
# are committed, so setup needs no download.
/data/vocab/

# Deck exports are generated on demand from your own progress.
/exports/
